---
import Layout from "../layouts/Layout.astro";
import body from "../partials/discovery.html?raw";
import headcss from "../partials/discovery.head.css?raw";
---
<Layout title={"Tell Us About Your Project — SouthStack"} description={""} path={"/discovery"} ogTitle={"Tell Us About Your Project — SouthStack"} ogDescription={""} chat={false} showFooter={false}>
  <Fragment slot="head">
    <style is:inline set:html={headcss}></style>
  </Fragment>
  <Fragment set:html={body} />
  <script is:inline>
    var params = new URLSearchParams(window.location.search);
    var clientName = '';
    var clientEmail = '';
    var tallyData = {};
    var tokenParam = params.get('t');

    // If token present, fetch tally data before starting
    var tokenLoaded = false;

    async function loadToken() {
      if (!tokenParam) { tokenLoaded = true; return; }
      try {
        var res = await fetch('/.netlify/functions/token?t=' + tokenParam);
        if (res.status === 410) {
          // Token expired
          document.getElementById('intro-screen').innerHTML =
            '<h1>This link has expired</h1>' +
            '<p>Discovery links expire after 7 days. You can submit a new enquiry or get in touch directly.</p>' +
            '<div class="discovery-intro-actions">' +
              '<a href="/contact.html" class="btn btn-primary">Submit a new enquiry</a>' +
              '<a href="mailto:hello@southstack.co.nz" class="skip-link">Email us directly</a>' +
            '</div>';
          tokenLoaded = true;
          return;
        }
        if (!res.ok) {
          document.getElementById('intro-screen').innerHTML =
            '<h1>Something went wrong</h1>' +
            '<p>We couldn\u2019t load your project details. You can still start the discovery chat or get in touch directly.</p>' +
            '<div class="discovery-intro-actions">' +
              '<button class="btn btn-primary" onclick="startChat()">Start anyway</button>' +
              '<a href="mailto:hello@southstack.co.nz" class="skip-link">Email us directly</a>' +
            '</div>';
          tokenLoaded = true;
          return;
        }
        var data = await res.json();
        if (data.tally) {
          tallyData = data.tally;
          clientName = tallyData.name || '';
          clientEmail = tallyData.email || '';
          if (clientName) {
            document.querySelector('.discovery-intro h1').textContent =
              'Hi ' + clientName.split(' ')[0] + ', tell us about your project';
          }
        }
      } catch (e) {}
      tokenLoaded = true;
    }

    var tokenPromise = loadToken();

    var chatHistory = [];
    var isLoading = false;
    var summaryText = '';

    var messagesEl = document.getElementById('chat-messages');
    var inputEl = document.getElementById('d-input');
    var sendBtn = document.getElementById('d-send');

    document.getElementById('d-send').addEventListener('click', sendMessage);
    document.getElementById('d-input').addEventListener('keydown', function(e) {
      if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); sendMessage(); }
    });

    inputEl.addEventListener('input', function() {
      this.style.height = 'auto';
      this.style.height = Math.min(this.scrollHeight, 120) + 'px';
    });

    async function startChat() {
      await tokenPromise;
      document.getElementById('intro-screen').style.display = 'none';
      document.getElementById('chat-messages').classList.add('active');
      document.getElementById('input-row').classList.add('active');
      document.getElementById('header-sub').textContent = 'SouthStack · Discovery';
      var greeting = clientName
        ? 'Hi ' + clientName.split(' ')[0] + '! Thanks for getting in touch. I have your form details — I just want to ask a few follow-up questions so we can put together an accurate proposal for you.\n\nFirst up: what\'s the main goal for this project? What does success look like for you?'
        : 'Hi there! Thanks for getting in touch. I just want to ask a few questions so SouthStack can put together an accurate proposal for you.\n\nFirst up: what\'s the main goal for this project? What does success look like for you?';
      addMessage(greeting, 'bot');
      chatHistory.push({ role: 'assistant', content: greeting });
      inputEl.focus();
    }

    function addMessage(text, role) {
      var div = document.createElement('div');
      div.className = 'd-msg ' + (role === 'user' ? 'd-msg-user' : 'd-msg-bot');
      div.textContent = text;
      messagesEl.appendChild(div);
      messagesEl.scrollTop = messagesEl.scrollHeight;
      return div;
    }

    function setLoading(state) {
      isLoading = state;
      sendBtn.disabled = state;
      inputEl.disabled = state;
    }

    async function sendMessage() {
      var text = inputEl.value.trim();
      if (!text || isLoading) return;
      inputEl.value = '';
      inputEl.style.height = 'auto';
      addMessage(text, 'user');
      chatHistory.push({ role: 'user', content: text });
      setLoading(true);

      var typing = document.createElement('div');
      typing.className = 'd-msg d-msg-bot d-msg-typing';
      typing.textContent = 'Thinking…';
      messagesEl.appendChild(typing);
      messagesEl.scrollTop = messagesEl.scrollHeight;

      try {
        var res = await fetch('/.netlify/functions/discovery', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            action: 'chat',
            messages: chatHistory,
            name: clientName,
            email: clientEmail,
            tally: tallyData
          })
        });
        var data = await res.json();
        typing.remove();

        var reply = data.reply || 'Sorry, something went wrong. Please email hello@southstack.co.nz.';
        chatHistory.push({ role: 'assistant', content: reply });

        if (data.summary) {
          summaryText = data.summary;
          showSummary(summaryText);
        } else {
          addMessage(reply, 'bot');
          document.getElementById('done-btn-row').style.display = 'block';
        }
      } catch (err) {
        typing.remove();
        addMessage('Sorry, I lost connection. Please try again or email hello@southstack.co.nz.', 'bot');
      }

      setLoading(false);
      inputEl.focus();
    }

    async function requestSummary() {
      document.getElementById('done-btn-row').style.display = 'none';
      chatHistory.push({ role: 'user', content: "I'm done, nothing else to add." });
      setLoading(true);
      var typing = document.createElement('div');
      typing.className = 'd-msg d-msg-bot d-msg-typing';
      typing.textContent = 'Putting your brief together…';
      messagesEl.appendChild(typing);
      messagesEl.scrollTop = messagesEl.scrollHeight;
      try {
        var res = await fetch('/.netlify/functions/discovery', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'chat', messages: chatHistory, name: clientName, email: clientEmail, tally: tallyData })
        });
        var data = await res.json();
        typing.remove();
        if (data.summary) {
          summaryText = data.summary;
          showSummary(summaryText);
        } else {
          addMessage(data.reply || 'Something went wrong — please email hello@southstack.co.nz.', 'bot');
          document.getElementById('done-btn-row').style.display = 'block';
        }
      } catch (err) {
        typing.remove();
        addMessage('Sorry, I lost connection. Please try again.', 'bot');
        document.getElementById('done-btn-row').style.display = 'block';
      }
      setLoading(false);
    }

    function showSummary(summary) {
      document.getElementById('chat-messages').classList.remove('active');
      document.getElementById('input-row').classList.remove('active');
      document.getElementById('summary-text').textContent = summary;
      document.getElementById('summary-screen').classList.add('active');
      document.getElementById('header-sub').textContent = 'SouthStack · Review your brief';
    }

    function goBackToChat() {
      document.getElementById('summary-screen').classList.remove('active');
      document.getElementById('chat-messages').classList.add('active');
      document.getElementById('input-row').classList.add('active');
      document.getElementById('done-btn-row').style.display = 'block';
      document.getElementById('header-sub').textContent = 'SouthStack · Discovery';
      inputEl.focus();
    }

    async function submitToNotion() {
      var btn = document.getElementById('submit-btn');
      btn.disabled = true;
      btn.textContent = 'Sending…';

      try {
        var res = await fetch('/.netlify/functions/discovery', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            action: 'submit',
            name: clientName,
            email: clientEmail,
            summary: summaryText
          })
        });
        var data = await res.json();
        if (data.ok) {
          document.getElementById('summary-screen').classList.remove('active');
          document.getElementById('done-name').textContent = clientName ? clientName.split(' ')[0] : 'there';
          document.getElementById('done-screen').classList.add('active');
          document.getElementById('header-sub').textContent = 'SouthStack · All done';
        } else {
          btn.disabled = false;
          btn.textContent = 'Send to SouthStack';
          alert('Something went wrong — please email hello@southstack.co.nz with your brief.');
        }
      } catch (err) {
        btn.disabled = false;
        btn.textContent = 'Send to SouthStack';
        alert('Could not connect — please email hello@southstack.co.nz with your brief.');
      }
    }
  </script>
</Layout>
