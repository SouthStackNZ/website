---
import Layout from "../layouts/Layout.astro";
import body from "../partials/thanks.html?raw";
import headcss from "../partials/thanks.head.css?raw";
---
<Layout title={"Thanks — SouthStack"} description={""} path={"/thanks"} ogTitle={"Thanks — SouthStack"} ogDescription={""} chat={false} showFooter={false}>
  <Fragment slot="head">
    <style is:inline set:html={headcss}></style>
  </Fragment>
  <Fragment set:html={body} />
  <script is:inline>
    (function() {
      var params = new URLSearchParams(window.location.search);
      var service = decodeURIComponent(params.get('service') || '');
      var business = decodeURIComponent(params.get('biz') || '');
      var name = decodeURIComponent(params.get('name') || '');
      var pages = decodeURIComponent(params.get('pages') || '');

      // Personalise heading
      if (name) {
        var first = name.split(' ')[0];
        document.getElementById('thanks-heading').textContent = 'Thanks ' + first + ' \u2014 we\u2019ve received your enquiry';
      }

      // Estimate calculation based on service type + pages
      function calcEstimate(service, pages) {
        var base = 0;
        var label = '';
        var suffix = '+ GST';
        var timeline = '';
        var detail = '';

        if (service.indexOf('Astro') > -1) {
          label = 'Astro marketing site';
          base = 350;
          timeline = '3\u20136 weeks';

          if (pages === '7\u201310' || pages === '7-10') {
            base = 550;
            detail = 'Includes extra pages beyond the standard 8-page scope.';
            timeline = '4\u20138 weeks';
          } else if (pages === '10+') {
            base = 750;
            detail = 'Larger scope \u2014 we\u2019ll confirm exact pricing in your proposal.';
            timeline = '6\u201310 weeks';
          }

        } else if (service.indexOf('Next.js') > -1) {
          label = 'Next.js business platform';
          base = 3500;
          timeline = '6\u201316 weeks';

          if (pages === '10+') {
            base = 6000;
            detail = 'Complex multi-feature platform \u2014 scoped individually.';
            timeline = '10\u201316 weeks';
          }

        } else if (service.indexOf('Redesign') > -1 || service.indexOf('rebuild') > -1) {
          label = 'Site redesign or rebuild';
          base = 350;
          timeline = 'Confirmed after discovery';
          detail = 'Starting price depends on scope \u2014 we\u2019ll confirm after learning more about the existing site.';

        } else if (service.indexOf('maintenance') > -1 || service.indexOf('Maintenance') > -1) {
          label = 'Maintenance retainer';
          base = 150;
          suffix = '/mo + GST';
          timeline = 'Min. 3-month commitment';

        } else if (service.indexOf('Data') > -1 || service.indexOf('AWS') > -1) {
          label = 'Data / AWS consulting';
          base = 500;
          timeline = 'Scoped after discovery';

        } else if (service.indexOf('RAG') > -1 || service.indexOf('AI assistant') > -1) {
          label = 'RAG AI assistant';
          base = 800;
          timeline = '1\u20133 weeks';

        } else if (service.indexOf('Not sure') > -1) {
          return null;

        } else {
          return null;
        }

        return {
          label: label,
          price: 'from $' + base.toLocaleString(),
          suffix: suffix,
          timeline: timeline,
          detail: detail
        };
      }

      var section = document.getElementById('estimate-section');
      var est = calcEstimate(service, pages);

      if (est) {
        var bizLine = est.label + (business ? ' \u2014 ' + business : '');
        var html =
          '<div class="estimate-card">' +
            '<div class="estimate-label">Starting estimate</div>' +
            '<div class="estimate-service">' + bizLine + '</div>' +
            '<div class="estimate-price">' + est.price + ' <span>' + est.suffix + '</span></div>' +
            '<div class="estimate-timeline">' + est.timeline + '</div>';
        if (est.detail) {
          html += '<div class="estimate-detail">' + est.detail + '</div>';
        }
        html += '<div class="estimate-note">This is a starting figure. Your written proposal will include a fixed price and full scope \u2014 no surprises.</div>';
        html += '</div>';
        section.innerHTML = html;
      }
    })();
  </script>
</Layout>
