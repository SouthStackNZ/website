---
import "../styles/global.css";
import Chatbot from "../components/Chatbot.astro";
const { title, description, path="/", ogTitle=title, ogDescription=description, chat=false, showFooter=true, noindex=false } = Astro.props;
const canonical = "https://southstack.co.nz" + path;
const consentChat = "<script is:inline>\n    (function() {\n      var banner = document.getElementById('cookie-banner');\n      var consent = localStorage.getItem('ss-cookie-consent');\n\n      function getChatToggle() { return document.getElementById('ss-chat-toggle'); }\n      function pushChatUp() { var t = getChatToggle(); if (t) t.style.bottom = (banner.offsetHeight + 16) + 'px'; }\n      function resetChat() { var t = getChatToggle(); if (t) t.style.bottom = ''; }\n\n      if (!consent) {\n        setTimeout(function() {\n          banner.classList.add('visible');\n          setTimeout(pushChatUp, 50);\n        }, 800);\n      }\n      window.cookieAccept = function() {\n        localStorage.setItem('ss-cookie-consent', 'accepted');\n        banner.classList.remove('visible');\n        resetChat();\n        loadAnalytics();\n      };\n      window.cookieDecline = function() {\n        localStorage.setItem('ss-cookie-consent', 'declined');\n        banner.classList.remove('visible');\n        resetChat();\n      };\n    })();\n  </script>";
const consentPlain = "<script is:inline>\n    (function() {\n      var banner = document.getElementById('cookie-banner');\n      var consent = localStorage.getItem('ss-cookie-consent');\n      if (!consent) {\n        setTimeout(function() { banner.classList.add('visible'); }, 800);\n      }\n      window.cookieAccept = function() {\n        localStorage.setItem('ss-cookie-consent', 'accepted');\n        banner.classList.remove('visible');\n        loadAnalytics();\n      };\n      window.cookieDecline = function() {\n        localStorage.setItem('ss-cookie-consent', 'declined');\n        banner.classList.remove('visible');\n      };\n    })();\n  </script>";
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <meta name="theme-color" content="#1a3d2b" />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <meta property="og:title" content={ogTitle} />
  <meta property="og:description" content={ogDescription} />
  <meta property="og:image" content="https://southstack.co.nz/og-image.png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:locale" content="en_NZ" />
  <meta property="og:site_name" content="SouthStack" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={ogTitle} />
  <meta name="twitter:description" content={ogDescription} />
  <meta name="geo.region" content="NZ-CAN" />
  <meta name="geo.placename" content="Rolleston, Selwyn, Canterbury, New Zealand" />
  <meta name="geo.position" content="-43.5933;172.3789" />
  <meta name="ICBM" content="-43.5933, 172.3789" />
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    // GA fires only after user accepts cookies
    window.loadAnalytics = function() {
      var s = document.createElement('script');
      s.async = true;
      s.src = 'https://www.googletagmanager.com/gtag/js?id=G-J530JH16CT';
      document.head.appendChild(s);
      gtag('config', 'G-J530JH16CT');
      var pl = document.createElement('script');
      pl.defer = true;
      pl.setAttribute('data-domain', 'southstack.co.nz');
      pl.src = 'https://plausible.io/js/script.js';
      document.head.appendChild(pl);
    };
    // Returning visitors who already accepted: load analytics immediately
    if (localStorage.getItem('ss-cookie-consent') === 'accepted') {
      window.loadAnalytics();
    }
  </script>
  <slot name="head" />
</head>
<body>
  <div class="page">
    <slot name="prenav" />
<nav>
    <a href="/" class="nav-logo">
      <img src="logo.webp" alt="" width="32" height="32">
      South<span>Stack</span>
    </a>
    <ul class="nav-links" id="nav-links">
      <li><a href="/services.html">Services</a></li>
      <li><a href="/about.html">About</a></li>
      <li><a href="/work.html">Work</a></li>
      <li><a href="/pricing.html">Pricing</a></li>
      <li><a href="/blog.html">Blog</a></li>
      <li><a href="/contact.html" class="nav-cta">Get in touch</a></li>
    </ul>
    <button class="nav-toggle" id="nav-toggle" aria-label="Toggle menu" aria-expanded="false" aria-controls="nav-links">
      <span></span><span></span><span></span>
    </button>
  </nav>
    <main>
      <slot />
    </main>
    {showFooter && (<footer>
    <div class="footer-inner">
    <!-- NEWSLETTER -->
    <div class="newsletter">
      <p class="newsletter-label">Stay in the loop</p>
      <p class="newsletter-sub">Occasional updates on web, AI, and what we're building.</p>
      <form class="newsletter-form" name="newsletter" method="POST" data-netlify="true" data-netlify-honeypot="bot-field">
        <input type="hidden" name="form-name" value="newsletter">
        <input type="hidden" name="bot-field">
        <input class="newsletter-input" type="email" name="email" placeholder="your@email.com" required>
        <button class="newsletter-btn" type="submit">Subscribe</button>
      </form>
    </div>

    <hr class="divider" style="width:100%;opacity:0.5;">

    <div class="socials">
        <a href="https://www.linkedin.com/company/111956608" target="_blank" rel="noopener" class="social-link" aria-label="LinkedIn"><svg viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg></a>
        <a href="https://www.instagram.com/southstacknz/" target="_blank" rel="noopener" class="social-link" aria-label="Instagram"><svg viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881z"/></svg></a>
        <a href="https://x.com/SouthStackNZ" target="_blank" rel="noopener" class="social-link" aria-label="X"><svg viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.744l7.737-8.835L1.254 2.25H8.08l4.259 5.631 5.905-5.631zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg></a>
        <a href="https://www.youtube.com/channel/UCI_KFkMnMIg4t4MWzhQ2E2w" target="_blank" rel="noopener" class="social-link" aria-label="YouTube"><svg viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg></a>
      </div>
      <ul class="footer-links">
        <li><a href="/services.html">Services</a></li>
        <li><a href="/about.html">About</a></li>
        <li><a href="/work.html">Work</a></li>
        <li><a href="/pricing.html">Pricing</a></li>
        <li><a href="/blog.html">Blog</a></li>
        <li><a href="/contact.html">Contact</a></li>
        <li><a href="/churches.html">Churches</a></li>
        <li><a href="/privacy.html">Privacy Policy</a></li>
<li><a href="/ethics.html">Code of Ethics</a></li><li><a href="/terms.html">Terms of Use</a></li>
      </ul>
      <p class="footer-copy">&copy; 2026 SOUTHSTACK LIMITED &mdash; ROLLESTON, CANTERBURY, NZ &mdash; NZBN 9429053502803</p>
    </div>
  </footer>)}
  </div>
<!-- COOKIE CONSENT BANNER -->
  <div class="cookie-banner" id="cookie-banner" role="region" aria-label="Cookie consent">
    <p style="margin:0">We use analytics to understand how people find us. No advertising or cross-site tracking. <a href="/privacy.html">Privacy Policy</a></p>
    <div class="cookie-actions">
      <button class="cookie-decline" onclick="cookieDecline()">Decline</button>
      <button class="cookie-accept" onclick="cookieAccept()">Accept</button>
    </div>
  </div>
  <slot name="post" />
  <script is:inline>
  const toggle = document.getElementById('nav-toggle');
  const links = document.getElementById('nav-links');
  if (toggle) toggle.addEventListener('click', () => {
    const open = links.classList.toggle('open');
    toggle.setAttribute('aria-expanded', String(open));
  });
</script>
  <Fragment set:html={chat ? consentChat : consentPlain} />
  {chat && <Chatbot />}
</body>
</html>
